<?xml version="1.0" encoding="UTF-8"?>
<TB.Vx.model.inputfile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../TB-Vx-EndTB-schema-E.xsd">
  <simulation from.year="1900" thru.year="2051">
    <options>
      <numerical.integration method="ode23" min.value.for.state.var="-1e-2"/>
    </options>
    <demography country.code="ignored" rescale.population="1950" use.SES.for.sex="true">
      <!-- ignored really means from command line-->
      <from.data>
        <population file="data/demographics_all.csv"/>
        <malepopulation file="data/demographics_male.csv"/>
        <femalepopulation file="data/demographics_female.csv"/>
        <birthrate from.population.data="true"/>
        <malemortality file="data/deathrates_male.csv"/>
        <femalemortality file="data/deathrates_female.csv"/>
      </from.data>
      <assortativity name="assortativity.by.sex" value="0.394088190538201" />
    </demography>
    <contact.matrix file="data/all_contacts_2021.txt" Mtb-strain="drugsens"/>
    <!-- country code will be prepended to file name e.g. ZAF_all_contacts_2020.txt -->
  </simulation>
  <output>
    <!--<final.population.as.fraction file="./data/IN-final-population-2050.txt"/>-->
    <detailed.output years="c(1980:2025)+0.5" age.group.lower.limits="0,15,25,35,45,55,65" econ.output="false" suppress.zeros.in.stocks="false" suppress.zeros.in.flows="false" combine.stocks.and.flows="false">
      <flows dim="TB" incidence="true" transmission="true" progression="true" treatment="true"/>
      <flows dim="HIV"/>
      <flows dim="VXa"/>
      <flows dim="SES"/>
      <flows dim="RISK"/>
    </detailed.output>
  </output>
  <ages lower.limits="5*(0:15)"/>
  <VXa>
    <VXa.stages>
      <stage name="never" fraction.at.birth="1"/>
    </VXa.stages>
  </VXa>
  <SES>
    <SES.stages>
      <stage name="male" fraction.at.birth="0.5"/>
      <stage name="female" fraction.at.birth="0.5"/>
    </SES.stages>
  </SES>
  <RISK>
    <RISK.stages>
      <stage name="risk0"/>
    </RISK.stages>
  </RISK>
  <HIV>
    <HIV.stages>
      <stage name="HIV-" fraction.at.birth="1"/>
    </HIV.stages>
  </HIV>
  <TB>
    <TB.stages>
      <stage name="Un" fraction.at.birth="1"/>
      <stage name="Uc"/>
      <stage name="Lf"/>
      <stage name="Ls"/>
      <stage name="Ds"/>
      <stage name="Dc"/>
      <stage name="T"/>
      <stage name="R"/>
      <stage name="TBdead"/>
      <stage name="Rdead"/>
    </TB.stages>
    <seeded.infections name="multiplier" value="1.84">
      <seeded.infection fraction="0.246" age.from="0" age.thru="99" stage="Uc"/>
      <seeded.infection fraction="0.0188" age.from="0" age.thru="99" stage="Lf"/>
      <seeded.infection fraction="0.198" age.from="0" age.thru="99" stage="Ls"/>
      <seeded.infection fraction="0.00317" age.from="0" age.thru="99" stage="Ds"/>
      <seeded.infection fraction="0.00265" age.from="0" age.thru="99" stage="Dc"/>
      <seeded.infection fraction="0.0484" age.from="0" age.thru="99" stage="R"/>
    </seeded.infections>
    <TB.progression>
      <age.groups>
        <age.group name="A0"/>
        <age.group name="A15"/>
        <age.group name="A25"/>
      </age.groups>
      <TB.parameter SES.stage="male" name="pE" value="0"/>
      <TB.parameter SES.stage="female" name="pE" value="0.6"/>
      <TB.parameter name="sage" age.group="A0" value="1"/>
      <TB.parameter name="sage" age.group="A15" value="1"/>
      <TB.parameter name="sage" age.group="A25" value="0.0330952994648182"/>
      <TB.parameter name="j1" age.group="A0" value="0.2499741"/>
      <TB.parameter name="j1" age.group="A15" value="1"/>
      <TB.parameter name="j1" age.group="A25" value="1"/>
      <TB.parameter name="j2" age.group="A0" value="0.556047493343911"/>
      <TB.parameter name="j2" age.group="A15" value="1"/>
      <TB.parameter name="j2" age.group="A25" value="1"/>
      <TB.parameter name="j3" age.group="A0" value="0.01"/>
      <TB.parameter name="j3" age.group="A15" value="1"/>
      <TB.parameter name="j3" age.group="A25" value="1"/>
      <TB.parameter name="j4" age.group="A0" value="0.191185897318127"/>
      <TB.parameter name="j4" age.group="A15" value="1.00814531699041"/>
      <TB.parameter name="j4" age.group="A25" value="1"/>
      <TB.parameter name="phiF" value="1.4e-06"/>
      <TB.parameter name="omega" value="0.5"/>
      <TB.parameter name="tau" value="0.5"/>
      <TB.parameter name="phiS" value="0.0368924255656368"/>
      <TB.parameter name="theta" value="0.10287526536222"/>
      <TB.parameter name="sigma" value="0.0015"/>
      <TB.parameter name="rho" value="0.09"/>
      <TB.parameter name="zeta" value="3.04417024672354"/>
      <TB.parameter name="chi" value="0.145147260271779"/>
      <TB.parameter name="eta" value="0.562956939991634"/>
      <TB.parameter name="kappa" value="0.15"/>
      <!-- COUNTRY SPECIFIC VALUE-->
      <TB.parameter SES.stage="female" name="sfr" value="0.97485822"/>
      <TB.parameter SES.stage="male" name="sfr" value="0.975528533352094"/>
      <!-- COUNTRY SPECIFIC VALUE-->
      <TB.parameter name="muK" value="0.0126281728826516"/>
      <TB.parameter name="muDc" value="0.5"/>
      <TB.parameter name="sh" value="0.233702461539128"/>
      <TB.parameter name="midx" value="1980"/>
      <transition.matrix>
        <transition from="Lf" to="Ls" rate="omega"/>
        <transition from="Lf" to="Uc" rate="phiF"/>
        <transition from="Ls" to="Uc" rate="phiS"/>
        <transition from="Ds" to="Dc" rate="zeta"/>
        <transition from="Ds" to="R" rate="chi"/>
        <transition from="Dc" to="R" rate="chi"/>
        <transition from="Dc" to="TBdead" rate="muDc*sage"/>
        <transition from="R" to="Rdead" rate="muK*sage*0.22"/>
      </transition.matrix>
      <!-- INDVIDUAL INC FLOW MATRIX : to get required flows-->
      <!-- modified by chris 09.12.2020-->
      <treatment.matrix name="LfLsRDs">
        <transition from="Lf" to="Ds" rate="(1-pE)*max(0.0696,theta*j1)"/>
        <transition from="Ls" to="Ds" rate="(1-pE)*max(0.000135,sigma*j2)"/>
        <transition from="R" to="Ds" rate="(1-pE)*max(0.01,rho*j3)"/>
      </treatment.matrix>
      <!-- TREATMENT INITIATION MATRIX -->
      <treatment.matrix name="init">
        <transition from="Dc" to="T" rate="eta*j4"/>
        <multiplier name="etamul" times="1959:2019" values="1/(1+exp(-sh*(x-midx)))"/>
      </treatment.matrix>
      <!-- TREATMENT SUCCESS/FAILURE/MORTALITY - MAY VARY BY COUNTRY-->
      <treatment.matrix name="nodead">
        <transition from="T" to="Dc" rate="(1-sfr)/tau"/>
        <transition from="T" to="R" rate="sfr/tau"/>
      </treatment.matrix>
      <treatment.matrix name="died">
        <!--transition from="T" to="Dc" rate="-(1-sfr)*kappa*sage/tau"/>
        <transition from="T" to="R" rate="-sfr*kappa*sage/tau"/-->
        <transition from="T" to="TBdead" rate="kappa*sage/tau"/>
      </treatment.matrix>
    </TB.progression>
    <TB.infectivity>
      <age.groups>
        <age.group name="A0"/>
        <age.group name="A15"/>
      </age.groups>
      <TB.parameter name="infs" value="0.8"/>
      <TB.parameter name="infc" value="1"/>
      <TB.parameter name="ep" value="0.113628517"/>
      <!--TB.parameter SES.stage="male" name="pEt" value="0"/>
      <TB.parameter SES.stage="female" name="pEt" value="0.398642639588293"/-->
      <!-- COUNTRY SPECIFIC VALUE-->
      <infectivity.matrix Mtb-strain="drugsens">
        <infectivity stage="Ds" value="(1-ep)*infs"/>
        <infectivity stage="Dc" value="(1-ep)*infc"/>
      </infectivity.matrix>
    </TB.infectivity>
    <TB.transmission>
      <age.groups>
        <age.group name="A0"/>
        <age.group name="A15"/>
      </age.groups>
      <TB.parameter SES.stage="male" name="pEt" value="0"/>
      <TB.parameter SES.stage="female" name="pEt" value="0.0401736743522303"/>
      <TB.parameter name="pT" value="0.000389016943004004"/>
      <TB.parameter name="pC" value="0.5"/>
      <TB.parameter name="pR" value="0.792320278687276"/>
      <TB.parameter name="omega" value="0.5"/>
      <TB.parameter name="theta" value="0.10287526536222"/>
      <TB.parameter name="j1" age.group="A0" value="0.2499741"/>
      <TB.parameter name="j1" age.group="A15" value="1"/>
      <transmission.matrix Mtb-strain="drugsens">
        <transition from="Un" to="Lf" rate="(1-pEt)*pT"/>
        <transition from="Uc" to="Lf" rate="(1-pEt)*pT*(1-pR*pC)"/>
        <transition from="Ls" to="Lf" rate="(1-pEt)*pT*(1-pR)"/>
        <transition from="R" to="Ds" rate="(1-pEt)*pT*(max(0.0696,j1*theta)/(max(0.0696,j1*theta)+omega))*(1-pR)"/>
        <multiplier name="beta" times="1800,2020" values="1,1"/>
      </transmission.matrix>
    </TB.transmission>
  </TB>
</TB.Vx.model.inputfile>
